rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  match /accounts/{uid} {
   allow read: if owner(uid);
   allow create, update: if owner(uid)
    && request.resource.data.keys().hasOnly(['version','revision','snapshotId','accountId','updatedAt'])
    && request.resource.data.version == 1
    && request.resource.data.revision is int
    && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1)
    && request.resource.data.snapshotId is string && request.resource.data.snapshotId.size() <= 128
    && request.resource.data.accountId is string && request.resource.data.accountId.size() <= 128
    && (resource == null || request.resource.data.accountId == resource.data.accountId)
    && request.resource.data.updatedAt == request.time
    && exists(/databases/$(database)/documents/accounts/$(uid)/snapshots/$(request.resource.data.snapshotId))
    && get(/databases/$(database)/documents/accounts/$(uid)/snapshots/$(request.resource.data.snapshotId)).data.accountId == request.resource.data.accountId;
   match /snapshots/{snapshotId} {
    allow read: if owner(uid);
    allow create: if owner(uid)
     && request.resource.data.keys().hasOnly(['version','count','byteLength','sha256','accountId','createdAt'])
     && request.resource.data.version == 1
     && request.resource.data.count is int && request.resource.data.count > 0 && request.resource.data.count <= 100
     && request.resource.data.byteLength is int && request.resource.data.byteLength > 0 && request.resource.data.byteLength <= 5242880
     && request.resource.data.sha256 is string && request.resource.data.sha256.size() == 64
     && request.resource.data.accountId is string && request.resource.data.accountId.size() <= 128
     && request.resource.data.createdAt == request.time;
    match /chunks/{chunkId} {
     allow read: if owner(uid);
     allow create: if owner(uid) && request.resource.data.keys().hasOnly(['data'])
      && request.resource.data.data is string && request.resource.data.data.size() <= 180000;
    }
   }
  }
 }
}
