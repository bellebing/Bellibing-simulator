{
  "name": "bellibing-simulator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:factory": "node --experimental-strip-types --test test/factory*.test.ts",
    "build": "node scripts/build-web.mjs",
    "export:characters": "node --experimental-strip-types scripts/export-character-database.ts",
    "report:factory-evidence": "node --experimental-strip-types scripts/generate-factory-evidence-report.ts",
    "audit:factory-evidence-report": "node --experimental-strip-types scripts/generate-factory-evidence-report.ts --check",
    "intake:factory-frequency-manager": "node --experimental-strip-types scripts/generate-factory-provider-intake.ts",
    "verify:fast:factory": "npm run test:factory && npm run audit:factory-evidence-report && npm run audit:profile-readiness && npm run build",
    "audit:echo-raw": "node --experimental-strip-types scripts/audit-echo-raw.mjs",
    "audit:sonata-effects": "node --experimental-strip-types scripts/audit-sonata-effects.mjs",
    "audit:echo-skills": "node --experimental-strip-types scripts/audit-echo-skills.mjs",
    "audit:profile-candidates": "node scripts/audit-profile-candidates.mjs",
    "audit:profile-source-accelerator": "node --experimental-strip-types scripts/audit-profile-source-import-accelerator.mjs",
    "audit:profile-horizontal-green-lane": "node --experimental-strip-types scripts/audit-profile-horizontal-green-lane.mjs",
    "audit:profile-cohort": "node --experimental-strip-types scripts/audit-profile-horizontal-cohort.mjs",
    "audit:profile-adapters": "node --experimental-strip-types scripts/audit-profile-adapter-matrix.mjs",
    "audit:profile-readiness": "node --experimental-strip-types scripts/audit-profile-readiness.mjs",
    "review:echo-skills": "node scripts/generate-echo-skill-source-inventory.mjs",
    "review:profile-candidates": "node scripts/generate-profile-candidate-review.mjs --input data/research/profile-source-roster-2026-08-29.json --output data/generated/profile-candidate-review.json",
    "review:profile-source-backlog": "node --experimental-strip-types scripts/export-profile-source-backlog.mjs --output data/generated/profile-source-backlog.json",
    "review:profile-source-accelerator": "node --experimental-strip-types scripts/generate-profile-source-import-accelerator.mjs --output data/generated/profile-source-import-accelerator.json",
    "review:profile-cohort": "node --experimental-strip-types scripts/generate-profile-horizontal-cohort.mjs",
    "sync:character-mechanics": "node --experimental-strip-types scripts/sync-character-mechanics.mjs",
    "review:character-mechanics": "node scripts/generate-character-mechanics-review.mjs",
    "review:character-mechanics-descriptions": "node scripts/generate-character-mechanics-description-review.mjs",
    "prepare:character-mechanics": "npm run sync:character-mechanics && npm run review:character-mechanics && npm run review:character-mechanics-descriptions",
    "audit:ui-echo-portraits": "node scripts/audit-ui-echo-portraits.mjs",
    "audit:ui-builder-icons": "node scripts/audit-ui-builder-icons.mjs",
    "report:character-actions": "node --experimental-strip-types scripts/report-character-actions.ts",
    "audit:character-actions": "node --experimental-strip-types scripts/report-character-actions.ts --check",
    "report:character-forte-rules": "node --experimental-strip-types scripts/report-character-forte-rules.ts",
    "audit:character-forte-rules": "node --experimental-strip-types scripts/report-character-forte-rules.ts --check",
    "report:character-inherent-passives": "node --experimental-strip-types scripts/report-character-inherent-passives.ts",
    "audit:character-inherent-passives": "node --experimental-strip-types scripts/report-character-inherent-passives.ts --check",
    "report:character-outro-effects": "node --experimental-strip-types scripts/report-character-outro-effects.ts",
    "audit:character-outro-effects": "node --experimental-strip-types scripts/report-character-outro-effects.ts --check",
    "capture:character-truth": "python scripts/export-prydwen-character-truth.py",
    "test:character-truth": "node --experimental-strip-types --test test/factoryCharacterTruthCapture.test.ts test/characterTruthDataset.test.ts",
    "report:character-truth": "node --experimental-strip-types scripts/generate-character-truth-reconciliation.ts && node --experimental-strip-types scripts/summarize-character-truth.ts",
    "preview:v1": "node scripts/preview-simulator-v1.mjs",
    "test:foundation": "node --experimental-strip-types --test test/inventoryAccount.test.mjs test/inventoryAccountStore.test.mjs test/inventoryBackupMigration.test.mjs test/accountSync.test.mjs test/accountWorkspacePersistence.test.mjs test/observedImproveSession.test.mjs test/ownedTeams.test.mjs test/recoveryImprovePresentation.test.mjs test/productBuildDraft.test.mjs",
    "test:foundation:browser": "node --experimental-strip-types --test test/inventoryPersistence.browser.mjs test/inventoryJourney.browser.mjs test/recoveryIntegration.browser.mjs test/productIntegration.browser.mjs test/productImport.browser.mjs",
    "test:foundation:firebase": "firebase emulators:exec --project demo-bellibing-foundation --only firestore,auth \"node --experimental-strip-types --test --test-concurrency=1 test/firebaseAccount.emulator.mjs test/firebaseGoogleAuth.emulator.mjs\"",
    "scanner:browser:prepare": "python3 scripts/prepare-browser-scanner.py",
    "test:scanner:browser": "node --experimental-strip-types --test test/browserScanner.browser.mjs",
    "preview:product": "node scripts/start-product-review.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "@playwright/test": "^1.58.2",
    "esbuild": "^0.27.3",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "15.6.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "firebase": "12.9.0",
    "pyodide": "0.29.3",
    "tesseract.js": "6.0.1"
  }
}
