{
  "name": "bellibing-simulator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "build": "node scripts/build-web.mjs",
    "audit:echo-raw": "node --experimental-strip-types scripts/audit-echo-raw.mjs",
    "audit:sonata-effects": "node --experimental-strip-types scripts/audit-sonata-effects.mjs",
    "audit:echo-skills": "node --experimental-strip-types scripts/audit-echo-skills.mjs",
    "audit:profile-candidates": "node scripts/audit-profile-candidates.mjs",
    "audit:profile-cohort": "node --experimental-strip-types scripts/audit-profile-horizontal-cohort.mjs",
    "audit:profile-adapters": "node --experimental-strip-types scripts/audit-profile-adapter-matrix.mjs",
    "audit:profile-readiness": "node --experimental-strip-types scripts/audit-profile-readiness.mjs",
    "review:echo-skills": "node scripts/generate-echo-skill-source-inventory.mjs",
    "review:profile-candidates": "node scripts/generate-profile-candidate-review.mjs --input data/research/profile-source-roster-2026-08-29.json --output data/generated/profile-candidate-review.json",
    "review:profile-cohort": "node --experimental-strip-types scripts/generate-profile-horizontal-cohort.mjs",
    "sync:character-mechanics": "node --experimental-strip-types scripts/sync-character-mechanics.mjs",
    "review:character-mechanics": "node scripts/generate-character-mechanics-review.mjs",
    "review:character-mechanics-descriptions": "node scripts/generate-character-mechanics-description-review.mjs",
    "prepare:character-mechanics": "npm run sync:character-mechanics && npm run review:character-mechanics && npm run review:character-mechanics-descriptions"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
